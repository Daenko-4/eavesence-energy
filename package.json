{
  "name": "eavesence-energy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run test && tsc --noEmit && npm run typecheck:mobile && npm run build",
    "mobile:start": "npm --workspace @eavesence/mobile run start",
    "mobile:android": "npm --workspace @eavesence/mobile run android",
    "mobile:ios": "npm --workspace @eavesence/mobile run ios",
    "typecheck:mobile": "npm --workspace @eavesence/mobile run typecheck"
  },
  "dependencies": {
    "@eavesence/core": "*",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
